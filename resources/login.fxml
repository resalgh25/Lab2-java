<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="LoginController">
   <children>
      <Label layoutX="262.0" layoutY="14.0" prefHeight="17.0" prefWidth="105.0" text="GCM Login" textAlignment="JUSTIFY" />
      <TextField fx:id="emailField" layoutX="93.0" layoutY="97.0" prefHeight="25.0" prefWidth="246.0" promptText="Enter your Email" />
      <Label fx:id="errorLabel" layoutX="93.0" layoutY="149.0" prefHeight="17.0" prefWidth="246.0" textFill="#d01010" />
      <PasswordField fx:id="passwordField" layoutX="93.0" layoutY="194.0" prefHeight="25.0" prefWidth="246.0" promptText="Enter your Password" />
      <Button fx:id="loginButton" layoutX="289.0" layoutY="342.0" mnemonicParsing="false" onAction="#handleLogin" text="login" />
   </children>
</AnchorPane>
